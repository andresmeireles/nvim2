{
  "StatelessWidget (stless)": {
    "prefix": ["stless", "stateless"],
    "description": "Create a Flutter StatelessWidget",
    "body": [
      "class ${1:MyWidget} extends StatelessWidget {",
      "  const ${1:MyWidget}({super.key});",
      "",
      "  @override",
      "  Widget build(BuildContext context) {",
      "    return ${2:const Placeholder()};",
      "  }",
      "}"
    ]
  },
  "StatefulWidget (stful)": {
    "prefix": ["stful", "stateful"],
    "description": "Create a Flutter StatefulWidget",
    "body": [
      "class ${1:MyWidget} extends StatefulWidget {",
      "  const ${1:MyWidget}({super.key});",
      "",
      "  @override",
      "  State<${1:MyWidget}> createState() => _${1:MyWidget}State();",
      "}",
      "",
      "class _${1:MyWidget}State extends State<${1:MyWidget}> {",
      "  @override",
      "  Widget build(BuildContext context) {",
      "    return ${2:const Placeholder()};",
      "  }",
      "}"
    ]
  }
}
